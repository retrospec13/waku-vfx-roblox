<roblox version="4">
  <Item class="Lighting" referent="0">
    <Properties>
      <string name="Name">Lighting</string>
      <float name="Brightness">1.3</float>
      <float name="ClockTime">9</float>
    </Properties>
    <Item class="BloomEffect" referent="1">
      <Properties>
        <string name="Name">Bloom</string>
