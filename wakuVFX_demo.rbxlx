      <Properties>
        <string name="Name">Baseplate</string>
        <bool name="Anchored">true</bool>
        <Color3uint8 name="Color3uint8">4014157</Color3uint8>
        <token name="Material">272</token>
        <Vector3 name="Position">
          <X>0</X>
          <Y>-1</Y>
          <Z>0</Z>
        </Vector3>
        <Vector3 name="size">
          <X>512</X>
          <Y>2</Y>
          <Z>512</Z>
        </Vector3>
        <token name="TopSurface">0</token>
      </Properties>
    </Item>
